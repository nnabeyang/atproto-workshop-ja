{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "linuxbrew",
    "customizations": {
        "codespaces": {
            "openFiles": [
                "README.md"
            ]
        },
        "vscode": {
            "extensions": [
                "swiftlang.swift-vscode"
            ]
        }
    },
    "forwardPorts": [3000, 2480],
    "remoteEnv": {
        "PROMPT_DIRTRIM": "2"
    }
}
